{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dado3D",
  "version": "0.1.0",
  "identifier": "app.erpg.dado3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dado3D",
        "width": 900,
        "height": 700,
        "minWidth": 360,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Dados 3D offline",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
