{
  "name": "dado3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild:web": "node scripts/sync-assets.mjs",
    "build:web": "tsc --noEmit && vite build && node scripts/pack-locales.mjs && node scripts/measure.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run test && npm run build:web",
    "cordova:prepare": "npm run build:web && node scripts/sync-cordova.mjs",
    "android": "npm run cordova:prepare && cordova build android --debug",
    "ios": "npm run cordova:prepare && cordova build ios --debug --emulator",
    "desktop": "tauri build"
  },
  "dependencies": {
    "@erpg/dice3dview": "git+https://github.com/erpg-app/Dice3DViwer.git#ae00d9f6cb9865378e59d49687c4588751532c5c",
    "@erpg/dicecore": "3.7.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^24.10.0",
    "cordova": "13.0.0",
    "cordova-android": "15.1.0",
    "cordova-ios": "8.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "cordova": {
    "platforms": [
      "android"
    ]
  }
}
